{
  "name": "Report",
  "type": "object",
  "properties": {
    "reference": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "Illegal dumping",
        "Street light out",
        "Water leak or drainage",
        "Pothole or road damage",
        "Safety concern"
      ]
    },
    "area": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "reporter": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "received",
        "in_progress",
        "fixed"
      ],
      "default": "received"
    },
    "assigned_to": {
      "type": "string"
    },
    "is_demo_data": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "reference",
    "type",
    "area"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}