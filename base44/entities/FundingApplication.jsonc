{
  "name": "FundingApplication",
  "type": "object",
  "properties": {
    "program": {
      "type": "string"
    },
    "business": {
      "type": "string"
    },
    "requested_amount": {
      "type": "number"
    },
    "purpose": {
      "type": "string"
    },
    "form_data": {
      "type": "object",
      "additionalProperties": true
    },
    "attached_documents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checklist_snapshot": {
      "type": "object",
      "additionalProperties": true
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "under_review",
        "approved",
        "declined"
      ],
      "default": "submitted"
    },
    "decision_note": {
      "type": "string"
    },
    "decided_by": {
      "type": "string"
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "is_demo_data": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "program",
    "business",
    "requested_amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}