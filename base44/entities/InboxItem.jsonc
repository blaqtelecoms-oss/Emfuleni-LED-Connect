{
  "name": "InboxItem",
  "type": "object",
  "properties": {
    "recipient": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "notice",
        "message"
      ],
      "default": "notice"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "sender": {
      "type": "string"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "affects_recipient": {
      "type": "boolean",
      "default": false
    },
    "is_demo_data": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "recipient",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.recipient": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "data.recipient": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}